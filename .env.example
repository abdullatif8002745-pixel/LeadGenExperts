# E-commerce Web Scraper Configuration
# Copy this file to .env and configure your settings

# Scraping Settings
RATE_LIMIT=2.0
USE_SELENIUM=false

# Output Settings
OUTPUT_DIR=output
DEFAULT_FORMAT=json

# Proxy Settings (Optional)
# USE_PROXY=false
# PROXY_URL=http://proxy.example.com:8080
# PROXY_USERNAME=
# PROXY_PASSWORD=

# User Agent (Optional - uses random user agents by default)
# CUSTOM_USER_AGENT=

# Logging
LOG_LEVEL=INFO
